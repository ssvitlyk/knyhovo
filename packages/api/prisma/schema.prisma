// append-only rule: price_history rows are INSERT-only. No UPDATE or DELETE.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Provider {
  YAKABOO   @map("yakaboo")
  BOOK_CLUB @map("book-club")
  VIVAT     @map("vivat")
  BOOK_YE   @map("book-ye")
  BOOKCHEF  @map("bookchef")
  LABORATORY @map("laboratory")
  KNIGOLAND @map("knigoland")
  MEGAKNIGA @map("megakniga")

  @@map("provider")
}

enum Currency {
  UAH

  @@map("currency")
}

enum CollectionType {
  DYNAMIC   @map("dynamic")
  EDITORIAL @map("editorial")
  TAXONOMIC @map("taxonomic")

  @@map("collection_type")
}

enum Availability {
  IN_STOCK     @map("in-stock")
  OUT_OF_STOCK @map("out-of-stock")
  UNKNOWN      @map("unknown")

  @@map("availability")
}

enum AlertStatus {
  ACTIVE @map("active")
  PAUSED @map("paused")

  @@map("alert_status")
}

/// How a user asked for the threshold to be chosen (notifications-model-v2 §3).
/// The engine never reads this — it is a resolver selector plus a display label.
enum AlertMode {
  ANY_DROP   @map("any-drop")
  GOOD_PRICE @map("good-price")
  MY_PRICE   @map("my-price")

  @@map("alert_mode")
}

/// What happens to the policy after a notification is delivered (§9.1).
enum AlertRearmPolicy {
  /// Threshold and baseline follow the price down after every email.
  FOLLOW_DOWN @map("follow-down")
  /// Threshold stays where the user (or the resolver) put it.
  STATIC      @map("static")

  @@map("alert_rearm_policy")
}

enum AlertIntent {
  ANY_DROP         @map("any-drop")
  BELOW_CURRENT    @map("below-current")
  FAVOURABLE_PRICE @map("favourable-price")
  CUSTOM_PRICE     @map("custom-price")

  @@map("alert_intent")
}

enum NotificationType {
  PRICE_DROP    @map("price-drop")
  BACK_IN_STOCK @map("back-in-stock")

  @@map("notification_type")
}

enum DeliveryStatus {
  PENDING @map("pending")
  SENT    @map("sent")
  FAILED  @map("failed")
  SKIPPED @map("skipped")

  @@map("delivery_status")
}

enum ScrapeRunKind {
  FULL_CATALOG           @map("full-catalog")
  WISHLIST_REFRESH       @map("wishlist-refresh")
  MANUAL                 @map("manual")
  DESCRIPTION_ENRICHMENT @map("description-enrichment")

  @@map("scrape_run_kind")
}

enum ScrapeRunStatus {
  RUNNING @map("running")
  SUCCESS @map("success")
  PARTIAL @map("partial")
  FAILED  @map("failed")

  @@map("scrape_run_status")
}

enum ScrapeRunTrigger {
  CRON   @map("cron")
  MANUAL @map("manual")
  SYSTEM @map("system")

  @@map("scrape_run_trigger")
}

enum GenreSource {
  SEED             @map("seed")
  PROVIDER_MAPPING @map("provider-mapping")
  MANUAL           @map("manual")

  @@map("genre_source")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model CanonicalBook {
  id        String   @id @default(uuid())
  title     String
  author    String
  /// null when no provider has supplied an ISBN for this book
  isbn      String?
  /// FK to a taxonomic `Collection` row (type = TAXONOMIC); null when the book
  /// has not been assigned to a genre. Column name kept as `genre_id` for
  /// migration simplicity — genres are now just Collection rows.
  genreId   String?  @map("genre_id")
  /// How the current genreId was assigned (seed / provider-mapping / manual).
  /// Null for pre-existing rows without an assignment source.
  genreSource     GenreSource? @map("genre_source")
  /// 0-100 confidence at the moment genreId was assigned; null for SEED/MANUAL.
  genreConfidence Int?         @map("genre_confidence")
  /// When genreId was last (re)assigned; null until first assignment.
  genreUpdatedAt  DateTime?    @map("genre_updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  listings      ProviderListing[]
  wishlistItems WishlistItem[]
  genre         Collection? @relation("CanonicalBookGenre", fields: [genreId], references: [id])

  @@index([isbn])
  @@index([genreId])
  @@index([createdAt])
  @@map("canonical_books")
}

model Collection {
  id           String         @id @default(uuid())
  slug         String         @unique
  type         CollectionType
  name         String
  description  String
  /// Optional decorative icon slug (e.g. lucide icon name); shown in UI chips/cards.
  icon         String?
  displayOrder Int            @default(0) @map("display_order")
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  items CollectionItem[]
  /// Books assigned to this collection when it's a TAXONOMIC (genre) row.
  genreBooks CanonicalBook[] @relation("CanonicalBookGenre")
  /// Provider category → genre mapping rules that resolve to this genre (TAXONOMIC rows only).
  genreMappings GenreMapping[] @relation("GenreMappingGenre")

  @@index([type, displayOrder])
  @@map("collections")
}

model CollectionItem {
  id              String @id @default(uuid())
  collectionId    String @map("collection_id")
  canonicalBookId String @map("canonical_book_id")
  sortOrder       Int    @map("sort_order")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, canonicalBookId])
  @@index([collectionId, sortOrder])
  @@map("collection_items")
}

model ProviderListing {
  id              String   @id @default(uuid())
  canonicalBookId String   @map("canonical_book_id")
  provider        Provider
  /// Title as it appears on the provider's site
  title           String
  /// Author as it appears on the provider's site
  author          String
  /// null when the provider page does not include an ISBN
  isbn            String?
  /// Price in the smallest currency unit (копійки). Always non-negative.
  priceAmount     Int      @map("price_amount")
  priceCurrency   Currency @map("price_currency")
  /// Direct URL to the book's page on the provider's site
  url             String
  lastSeenAt      DateTime @map("last_seen_at")
  availability    Availability @default(UNKNOWN) @map("availability")
  /// Cover image URL extracted from the provider's catalog card (W9a F1).
  /// null when the card exposed no usable image; enrichment never overwrites a known cover with null.
  coverUrl        String?  @map("cover_url")
  /// Sanitized plain-text description scraped from the provider's product page (W9a F2).
  /// null when the product page exposed no usable description; enrichment never overwrites a known description with null.
  description     String?  @map("description")
  /// Publisher as provider text, as-is (book-metadata PRD); enrichment never overwrites a known value with null.
  publisher       String?  @map("publisher")
  /// Language as provider text, as-is (book-metadata PRD); enrichment never overwrites a known value with null.
  language        String?  @map("language")
  /// Format/cover type as provider text, as-is (book-metadata PRD); enrichment never overwrites a known value with null.
  format          String?  @map("format")
  /// Series as provider text, as-is (book-metadata PRD); enrichment never overwrites a known value with null.
  series          String?  @map("series")
  /// Publication year (book-metadata PRD); enrichment never overwrites a known value with null.
  publicationYear Int?     @map("publication_year")
  /// Raw category/breadcrumb signal, root→leaf (breadcrumb providers) or unordered
  /// (KSD categories). Provider-native text (trim/whitespace-collapse only). Empty
  /// means no signal collected yet; a scrape without categories never clears a
  /// previously collected value.
  rawCategories String[] @default([]) @map("raw_categories")

  canonicalBook CanonicalBook       @relation(fields: [canonicalBookId], references: [id])
  priceHistory  PriceHistoryPoint[]

  @@unique([provider, url])
  @@index([provider, canonicalBookId])
  // `canonical_books ⋈ provider_listings` on canonicalBookId alone is the join
  // backbone of every collections feed query (repository.ts `candidateCte`) —
  // the composite index above is led by `provider` and can't serve a lookup
  // keyed purely on canonicalBookId (PRD C1 §3.3 flagged this as optional
  // pending EXPLAIN; in practice every feed query depends on it, not just the
  // min-price aggregate).
  @@index([canonicalBookId])
  @@map("provider_listings")
}

// append-only: INSERT only. No UPDATE or DELETE ever.
// A new row is recorded only when price OR availability changed (see price-history/service.ts).
model PriceHistoryPoint {
  id                String   @id @default(uuid())
  providerListingId String   @map("provider_listing_id")
  /// Price in the smallest currency unit (копійки). Always non-negative.
  priceAmount       Int      @map("price_amount")
  priceCurrency     Currency @map("price_currency")
  /// Availability of the listing at the moment this snapshot was recorded.
  availability      Availability @default(UNKNOWN) @map("availability")
  recordedAt        DateTime @map("recorded_at")

  providerListing ProviderListing @relation(fields: [providerListingId], references: [id])

  // Timeline / latest-price queries (ASC; Postgres scans backward for latest).
  @@index([providerListingId, recordedAt])
  // Lowest-price-ever queries and future verdict calculations.
  @@index([providerListingId, priceAmount])
  @@map("price_history")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  /// W4b notification preferences.
  priceDropEnabled   Boolean   @default(true) @map("price_drop_enabled")
  backInStockEnabled Boolean   @default(true) @map("back_in_stock_enabled")
  /// Stable token for one-click unsubscribe links. Null until first generated (lazy).
  unsubscribeToken   String?   @unique @map("unsubscribe_token")
  /// Global opt-out timestamp; when set, no alert emails are sent.
  unsubscribedAt     DateTime? @map("unsubscribed_at")
  /// Optional display name shown in the UI profile.
  displayName        String?   @map("display_name")

  wishlistItems   WishlistItem[]
  loginCodes      LoginCode[]
  magicLinkTokens MagicLinkToken[]
  sessions        Session[]
  deliveries      NotificationDelivery[]

  @@map("users")
}

model LoginCode {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("login_codes")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use Magic Link tokens for passwordless login. The clickable email link
/// carries a random token; only its SHA-256 hash is stored. One-time (consumedAt)
/// with a short TTL. `returnTo` is the validated internal path to land on after login.
model MagicLinkToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  returnTo   String?   @map("return_to")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("magic_link_tokens")
}

model WishlistItem {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  canonicalBookId     String    @map("canonical_book_id")
  createdAt           DateTime  @default(now()) @map("created_at")

  user          User          @relation(fields: [userId], references: [id])
  canonicalBook CanonicalBook @relation(fields: [canonicalBookId], references: [id])
  alert         Alert?

  @@unique([userId, canonicalBookId])
  @@index([canonicalBookId])
  @@map("wishlist_items")
}

model ScrapeRun {
  id                  String           @id @default(uuid())
  provider            Provider
  kind                ScrapeRunKind
  status              ScrapeRunStatus  @default(RUNNING)
  /// What initiated this run: scheduled cron, an explicit manual trigger, or an internal system process.
  triggeredBy         ScrapeRunTrigger @map("triggered_by")
  startedAt           DateTime         @map("started_at")
  /// Liveness signal updated periodically during a run; null only on rows created before this migration.
  lastHeartbeatAt     DateTime?        @map("last_heartbeat_at")
  finishedAt          DateTime?        @map("finished_at")
  durationMs          Int?             @map("duration_ms")
  itemsFound          Int              @default(0) @map("items_found")
  itemsUpdated        Int              @default(0) @map("items_updated")
  priceChanges        Int              @default(0) @map("price_changes")
  availabilityChanges Int              @default(0) @map("availability_changes")
  errorsCount         Int              @default(0) @map("errors_count")
  /// Keyset checkpoint for DESCRIPTION_ENRICHMENT runs: last processed provider_listings.id,
  /// written atomically with each batch. NOT NULL ⇔ the campaign has more to do; cleared (NULL)
  /// when the candidate queue is exhausted (megakniga-resumable-enrichment PRD §4.2).
  cursor              String?
  /// Live processed counter for DESCRIPTION_ENRICHMENT runs — includes fetch failures and
  /// pages with no usable data (unlike itemsUpdated). Updated after every committed batch.
  itemsProcessed      Int              @default(0) @map("items_processed")
  /// Truncated summary of the first few errors (null when none).
  errorSummary        String?          @map("error_summary")
  /// Free-form run context (scraper options used, target counts, etc.). Null when not applicable.
  metadata            Json?

  /// NOTE: a raw-SQL partial unique index "scrape_runs_one_active_enrichment"
  /// (migration 20260719160000) enforces at most one RUNNING run per provider
  /// for kind=DESCRIPTION_ENRICHMENT. Prisma cannot express partial indexes,
  /// so it lives only in the migration — do not "clean it up" on drift.
  @@index([provider, kind, startedAt])
  @@map("scrape_runs")
}

model Alert {
  id                  String      @id @default(uuid())
  wishlistItemId      String      @unique @map("wishlist_item_id")
  status              AlertStatus @default(ACTIVE)
  /// The UX mode the user picked. Resolver selector + display label only — the
  /// engine works exclusively with the policy fields below (§9.1).
  mode                AlertMode
  /// @deprecated Superseded by `mode`; kept for one release so a rollback can read it.
  intent              AlertIntent
  /// Policy: the price whose reaching is an event (копійки).
  targetPriceAmount   Int         @map("target_price_amount")
  targetPriceCurrency Currency    @map("target_price_currency")
  /// Policy: the price a further drop is measured against (копійки). Null for
  /// static policies, where only the threshold matters.
  baselineAmount      Int?             @map("baseline_amount")
  /// Policy: what happens to threshold/baseline after a delivered notification.
  rearmPolicy         AlertRearmPolicy @default(STATIC) @map("rearm_policy")
  /// Policy provenance: which resolver rule produced `targetPriceAmount`.
  thresholdBasis      String?          @map("threshold_basis")
  /// Policy provenance: the human-readable proof shown in the UI and the email.
  thresholdProof      String?          @map("threshold_proof")
  pausedAt            DateTime?   @map("paused_at")
  /// Dedup marker (W10.4): when this alert last fired a notification. Null until first notification.
  /// Reset to null when the price condition no longer holds, re-arming a future notification.
  lastNotifiedAt          DateTime? @map("last_notified_at")
  /// The lowest price (копійки) at the moment of the last notification. A subsequent
  /// notification fires only when the lowest price drops strictly below this value.
  lastNotifiedPriceAmount Int?      @map("last_notified_price_amount")
  /// Back-in-stock dedup (W4b): when a back-in-stock notification last fired. Null until first one.
  lastStockNotifiedAt      DateTime?     @map("last_stock_notified_at")
  /// Availability observed at the last back-in-stock notification; used to detect a fresh OUT→IN transition.
  lastNotifiedAvailability Availability? @map("last_notified_availability")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  wishlistItem WishlistItem @relation(fields: [wishlistItemId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  @@map("alerts")
}

model NotificationDelivery {
  id                 String           @id @default(uuid())
  alertId            String           @map("alert_id")
  userId             String           @map("user_id")
  canonicalBookId    String           @map("canonical_book_id")
  type               NotificationType
  status             DeliveryStatus   @default(PENDING)
  /// Lowest in-stock price (копійки) at trigger time; null for back-in-stock.
  triggerPriceAmount Int?             @map("trigger_price_amount")
  /// Idempotency key (see agent_docs/alert-engine.md). Unique across all deliveries.
  dedupKey           String           @unique @map("dedup_key")
  attempts           Int              @default(0)
  /// Earliest time this delivery may be retried (backoff). Null = eligible now.
  nextAttemptAt      DateTime?        @map("next_attempt_at")
  lastError          String?          @map("last_error")
  /// Resend message id once accepted by the provider.
  providerMessageId  String?          @map("provider_message_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  sentAt             DateTime?        @map("sent_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@index([alertId])
  @@map("notification_deliveries")
}

/// Per-URL crawl bookkeeping for sitemap-driven incremental scraping
/// (bookchef-incremental-scraping PRD §2). Deliberately no relation/FK to
/// `ProviderListing` — this state tracks URLs that may never get a business
/// row (e.g. a sitemap entry whose product page has no price yet).
model ProviderScrapeState {
  provider Provider @map("provider")
  url      String
  /// Watermark: sitemap <lastmod> of the last successfully processed fetch
  /// for this URL. Null until a fetch succeeds.
  sourceLastmod DateTime? @map("source_lastmod")
  /// When this URL was last seen present in a successfully-parsed sitemap
  /// (presence bookkeeping, independent of fetch success).
  lastSeenInSitemapAt DateTime @map("last_seen_in_sitemap_at")
  /// When this URL's page was last actually fetched (regardless of persist outcome).
  lastFetchedAt DateTime? @map("last_fetched_at")

  @@id([provider, url])
  @@index([provider, lastSeenInSitemapAt])
  @@map("provider_scrape_state")
}

model GenreMapping {
  id       String   @id @default(uuid())
  provider Provider
  /// Normalized key (genres/normalize.ts): for book-club — category slug,
  /// for breadcrumb providers — lowercased whitespace-collapsed name.
  sourceCategory String @map("source_category")
  /// FK to a TAXONOMIC `Collection` row. NULL = explicit "ignore" (known junk
  /// like "Акції" drops out of the unmapped report).
  genreId String? @map("genre_id")
  /// 0-100. Leaf/specific categories 90-100, broad roots ("Художня література") 40-60.
  confidence Int      @default(100)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  genre Collection? @relation("GenreMappingGenre", fields: [genreId], references: [id])

  @@unique([provider, sourceCategory])
  @@index([genreId])
  @@map("genre_mappings")
}
