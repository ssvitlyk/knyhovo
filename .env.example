# Local development setup:
#   cp .env.example packages/api/.env
#
# Prisma CLI reads .env from packages/api/ (not the repo root).
# packages/api/.env is gitignored — never commit real secrets.

# PostgreSQL connection string for local development (matches docker-compose.yml)
DATABASE_URL="postgresql://knyhovo:knyhovo@localhost:5432/knyhovo"

# packages/web reads this server-side (SSR) to reach the API. Default is
# http://localhost:3000 — MUST be set to the real API host in every deployed
# environment (e.g. Vercel Preview/Production project settings), otherwise
# every SSR fetch (collections hub, book pages, search) fails and degrades to
# the UI's generic error/retry state. An empty string counts as unset — don't
# create the var with a blank value.
API_BASE_URL="http://localhost:3000"

# Background enrichment job (`pnpm --filter @knyhovo/api scrape:enrich`,
# megakniga-resumable-enrichment PRD). All optional:
#   SCRAPE_ENRICH_BATCH_SIZE — listings per batch/transaction (default 50);
#     an explicit --batch-size CLI flag wins over the env value.
#   SCRAPE_ENRICH_DELAY_MS — delay between product-page requests in ms
#     (default: the provider's own enrichment delay, e.g. 300 for megakniga).
#   SCRAPE_ENRICH_CIRCUIT_BREAKER_THRESHOLD — consecutive infrastructure
#     failures (timeout/DNS/connection/5xx, NOT 429/503) that stop the run so a
#     mass site outage does not fetch-fail all ~27k listings; the run stays
#     resumable and exits 75 (default 10, breaker on).
#   SCRAPE_ENRICH_MAX_NO_PROGRESS_RESTARTS — restart-loop guard: after this many
#     consecutive prior runs each made zero progress (items_processed=0), the
#     next start refuses to run and exits 0 to break the loop (default 3).
# SCRAPE_ENRICH_BATCH_SIZE="50"
# SCRAPE_ENRICH_DELAY_MS="300"
# SCRAPE_ENRICH_CIRCUIT_BREAKER_THRESHOLD="10"
# SCRAPE_ENRICH_MAX_NO_PROGRESS_RESTARTS="3"

# Scrape-run liveness (stale-scrape-recovery PRD; shared by catalog/wishlist
# refresh and scrape:enrich). All optional:
#   SCRAPE_HEARTBEAT_INTERVAL_SECONDS — how often a RUNNING run touches
#     last_heartbeat_at (default 60).
#   SCRAPE_HEARTBEAT_TIMEOUT_MINUTES — heartbeat silence after which a RUNNING
#     row is considered dead and auto-reaped on the next start (default 15).
#   SCRAPE_STALE_STARTEDAT_TIMEOUT_HOURS — age fallback for legacy rows with
#     last_heartbeat_at=NULL (default 24).
# SCRAPE_HEARTBEAT_INTERVAL_SECONDS="60"
# SCRAPE_HEARTBEAT_TIMEOUT_MINUTES="15"
# SCRAPE_STALE_STARTEDAT_TIMEOUT_HOURS="24"
